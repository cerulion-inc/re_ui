      "color": "{Gray.200}"
    },
    "visualizer_list_pill_bg_color_hovered": {
      "color": "{Gray.250}"
    },

    //array indices
    "code_index_color": {
      "color": "#CC9CC6"
    },

    // null
    "code_null_color": {
      "color": "#C8A973"
    },
    // numbers, bool
