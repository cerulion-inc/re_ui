{
  "large_button_size": 22,
  "large_button_icon_size": 12,
  "large_button_corner_radius": 6,
  "small_icon_size": 14,
  "color_swatch_size": 14,
  "modal_button_width": 50,
  "default_modal_width": 400,

  "spatial_label_bg_opacity": 0.5,
  "slow_animation_duration_sec": 0.2,
  "plot_grid_fade": 0.3,

  "table_grid_view_card_min_width": 350,
  "table_grid_view_card_spacing": 8,
  "table_grid_view_card_inner_margin": 12,
  "table_grid_view_card_corner_radius": 12,

  "loop_selection_alpha": 0.55, // Multiplied with selection_bg_fill
  "loop_selection_alpha_inactive": 0.20, // Multiplied with selection_bg_fill

  "Alias": {
    "native_frame_stroke": {
      "color": "{Gray.250}",
      "width": 1
    },
    "windows_close_button_hover_color": {
      "color": "#C42B1C"
    },
    "top_bar_color": {
      // CER-868 row 5 — palette.toml `bg-stage`. Co-reference with
      // `panel_bg_color`: both are {Gray.100} (#0d0d0d) upstream, so they move
      // in lockstep — otherwise row 1 would split one upstream colour into two
      // Studio colours and seam the top bar against the panel it abuts.
      "color": "#10161f"
    },
    "tab_bar_color": {
      // CERULION FORK — CER-882: palette.toml `bg-header` (was {Gray.200}
      // #212121, a WARM neutral). This is the STAGE-TOP BAND: `re_viewport`'s
      // `TabViewer::tab_bar_color` reads this token directly, and `egui_tiles`
      // fills the whole view-tab strip with it (`container/tabs.rs`
      // `tab_bar_ui`) — the band that abuts Studio's `bg-header` #0c1219
      // sidebar header across the shell's divider. Two chrome bands meeting at
      // one seam must read as ONE surface, so the tab bar takes the same
      // chrome tone the sidebar header + status bar already use.
      //
      // It is deeper than `panel_bg_color` (#10161f) BY DESIGN — that is
      // Studio's chrome grammar (chrome bands sit under content, exactly like
      // the sidebar's header/footer under its topic list), and an ACTIVE tab is
      // painted from `visuals.panel_fill` so it still lifts out of the bar and
      // connects to the stage below.
      //
      // Also reached: `egui_tiles::Behavior::resize_stroke` paints the IDLE gap
      // between side-by-side tiles with this colour, so the seams between views
      // stop being warm-grey lines on a cool blue-black stage.
      //
      // CER-868 left this token stock because mapping it alone "would introduce
      // a blue/neutral seam against the still-stock bottom bar". There is no
      // such seam — but NOT because `bottom_bar_color` is unused. It is read:
      // `DesignTokens::bottom_panel_frame()` takes it as the frame `fill`
      // (`src/design_tokens.rs`), and `re_viewer` calls that helper at four
      // sites. Three of them replace the fill straight away — the blueprint
      // time panel (`.fill(blueprint_time_panel_bg_fill)`), the dev panel and
      // the iOS/Android mobile-warning banner (both `ui.visuals().panel_fill`)
      // — so this colour survives to the screen at exactly ONE: the time panel
      // / streams view, which takes the frame verbatim. Studio's bare stage
      // pins `panel_state_overrides.time = Some(PanelState::Hidden)` (CER-853)
      // and `TimePanel::show_panel` early-returns while hidden, so that one
      // surface never paints in the default UI. It stays stock: nothing visible
      // to seam against, and upstream's rung sits above the panel with no clean
      // Studio tier. See CERULION-PATCH.md for the call-site list.
      "color": "#0c1219"
    },
    "bottom_bar_color": {
      "color": "{Gray.150}"
    },
    "bottom_bar_stroke": {
      "color": "{Gray.250}",
      "width": 1
    },
    "shadow_gradient_dark_start": {
      "color": "{Gray.0}",
      "alpha": 77
    },
    "strong_fg_color": {
      "color": "{Gray.1000}"
    },
    "info_log_text_color": {
      "color": "{Green.700}"
    },
    "debug_log_text_color": {
      "color": "{Blue.700}"
    },
    "trace_log_text_color": {
      "color": "{Gray.700}"
    },

    "success_text_color": {
      "color": "{Green.700}"
    },
    "info_text_color": {
      "color": "{Blue.700}"
    },

    "viewport_background": {
      "color": "{Gray.0}"
    },

    "highlight_color": {
      // Background color for widgets that should catch the user's attention
      "color": "{Blue.500}",
      "alpha": 120
    },

    "label_button_icon_color": {
      "color": "{Gray.750}"
    },
    "section_header_color": {
      "color": "{Gray.200}"
    },

    "loop_everything_color": {
      "color": "#02502D"
    },
    "thumbnail_background_color": {
      "color": "{Gray.250}"
    },

    "example_card_background_color": {
      "color": "#FFFFFF0A"
    },
    "example_tag_bg_fill": {
      "color": "{Gray.300}",
    },
    "example_tag_stroke": {
      "color": "{Gray.200}",
      "width": 1
    },

    // Breadcrumb colors, among other things ("primary" means "selected" in this case):
    "surface_on_primary_hovered": {"color": "{Gray.1000}", "alpha": 25},
    "text_color_on_primary": {"color": "{Blue.900}"},// TODO(emilk): unify with selection_stroke_color ?
    "text_color_on_primary_hovered": {"color": "{Gray.1000}"},
    "icon_color_on_primary": {"color": "{Blue.750}"},
    "icon_color_on_primary_hovered": {"color": "{Gray.1000}"},
    "selection_bg_fill": {
      "color": "{Blue.500}"
    },
    "selection_stroke_color": {
      "color": "{Blue.900}" // TODO(emilk): should we unify this with text_color_on_primary?
    },
    "focus_outline_stroke": {
      "color": "{Blue.400}",
      "width": 1
    },
    "focus_halo_stroke": {
      "color": "{Blue.350}",
      "alpha": 75,
      "width": 2
    },

    "panel_bg_color": {
      // CER-868 row 1 — palette.toml `bg-stage` (was {Gray.100} #0d0d0d). The
      // idle/letterbox stage fill `paint_background_fill` reads directly.
      "color": "#10161f"
    },
    "text_edit_bg_color": {
      "color": "{Gray.200}"
    },

    "form_field_bg_color": {
      "color": "{Gray.200}"
    },
    "form_selectable_bg_color": {
      "color": "{Gray.250}"
    },
    "form_selectable_stroke_color": {
      "color": "{Gray.350}"
    },

    "blueprint_time_panel_bg_fill": {
      "color": "#141326"
    },

    "notification_panel_background_color": {
      // CER-868 row 4 — palette.toml `bg-elevated` (was {Gray.150} #171717).
      // The notification-list PANEL: the deeper of the two toast surfaces,
      // preserving upstream's panel-deeper-than-card ordering.
      "color": "#182338"
    },
    "notification_background_color": {
      // CER-868 row 4 — palette.toml `border` (was {Gray.200} #212121). The
      // individual toast CARD: the brighter of the two named Studio values, so
      // the card still reads raised above its panel. `border`'s hue is used
      // here as a surface fill, not a stroke — it is the elevated blue-grey the
      // Studio palette assigns to this rung above `bg-elevated`.
      "color": "#223047"
    },

    "table_header_bg_fill": {
      "color": "{Gray.150}"
    },
    "table_header_stroke_color": {
      "color": "{Gray.300}"
    },
    "table_interaction_hovered_bg_stroke": {
      "color": "{Gray.300}"
    },
    "table_interaction_active_bg_stroke": {
      "color": "{Gray.350}"
    },
    "table_interaction_noninteractive_bg_stroke": {
      "color": "{Gray.200}"
    },
    "table_interaction_row_selection_fill": {
      "color": "{Blue.750}",
      "alpha": 25
    },
    "table_sort_icon_color": {
      "color": "{Blue.450}"
    },
    "table_grid_view_card_fill": {
      "color": "{Gray.150}"
    },
    "table_grid_view_card_hover_fill": {
      "color": "{Gray.200}"
    },

    "drag_pill_droppable_fill": {
      "color": "{Blue.325}"
    },
    "drag_pill_droppable_stroke": {
      "color": "{Blue.375}"
    },
    "drag_pill_nondroppable_fill": {
      "color": "{Gray.300}"
    },
    "drag_pill_nondroppable_stroke": {
      "color": "{Gray.400}"
    },
    "drop_target_container_stroke": {
      "color": "{Blue.350}",
      "width": 2
    },
    "tile_drag_preview_stroke" : {
      "color": "{Gray.1000}",
      "alpha": 127,
      "width": 1
    },
    "tile_drag_preview_color": {
      "color": "{Gray.1000}",
      "alpha": 26
    },

    "floating_color": {
      "color": "{Gray.200}"
    },
    "faint_bg_color": {
      "color": "{Gray.150}"
    },
    "plot_grid_color": {
      "color": "{Gray.200}"
    },
    "extreme_bg_color": {
      "color": "{Gray.0}"
    },
    "extreme_fg_color": {
      "color": "{Gray.1000}"
    },
    "widget_inactive_bg_fill": {
      "color": "{Gray.300}"
    },
    "widget_hovered_color": {
      "color": "{Gray.300}"
    },
    "widget_hovered_weak_bg_fill": {
      "color": "{Gray.300}"
    },
    "widget_hovered_bg_fill": {
      "color": "{Gray.300}"
    },
    "widget_active_weak_bg_fill": {
      "color": "{Gray.300}"
    },
    "widget_active_bg_fill": {
      "color": "{Gray.300}"
    },
    "widget_open_weak_bg_fill": {
      "color": "{Gray.300}"
    },
    "widget_noninteractive_weak_bg_fill": {
      "color": "{Gray.150}"
    },
    "widget_noninteractive_bg_fill": {
      "color": "{Gray.150}"
    },
    "widget_noninteractive_bg_stroke": {
      "color": "{Gray.250}"
    },
    "text_subdued": {
      "color": "{Gray.550}"
    },
    "text_default": {
      "color": "{Gray.750}"
    },
    "text_strong": {
      "color": "{Gray.1000}"
    },
    "error_fg_color": {
      "color": "#AB0116"
    },
    "warn_fg_color": {
      "color": "#FF7A0C"
    },
    "popup_shadow_color": {
      "color": "#00000080"
    },

    "density_graph_selected": {
      "color": "{Blue.800}"
    },
    "density_graph_unselected": {
      "color": "{Gray.700}"
    },
